{
  "manifest_version": 3,
  "name": "AccessFix",
  "version": "0.1.0",
  "description": "Check a page for screen-reader, colour and motion issues using your AccessFix backend.",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "tabs", "storage"],
  "host_permissions": ["http://localhost:3001/*", "http://127.0.0.1:3001/*"],
  "action": { "default_title": "Open AccessFix" },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "index.html" }
}
