# Copy to .env. Backend only: never expose these values to client code.

# Daytona: the team's existing sandbox. AccessFix never creates or deletes one.
DAYTONA_API_KEY=
DAYTONA_SANDBOX_ID=

# Neo4j: for Aura, the URI looks like neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# Optional. Leave blank to use the server's default database.
NEO4J_DATABASE=

# Nosana: an OpenAI-compatible base URL, usually ending in /v1
NOSANA_API_KEY=
NOSANA_BASE_URL=
NOSANA_MODEL=
